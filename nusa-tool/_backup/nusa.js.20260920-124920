function setProgress(text, opts) {
  opts = opts || {};
  const s = $('status');
  if (s) s.textContent = text;
  const head = document.querySelector('.narration-col .col-head');
  if (!head) return;
  let dot = head.querySelector('.work-dot');
  if (opts.busy === false) {
    if (dot) dot.remove();
    head.classList.remove('working');
    return;
  }
  if (!dot) {
    dot = document.createElement('span');
    dot.className = 'work-dot';
    head.appendChild(dot);
  }
  head.classList.add('working');
}

function buildSummaryCards(ctx) {
  const container = $('summary-cards');
  if (!container || !ctx) return;

  const findings = ctx.findings || [];
  const modules = ctx.modules || { UX: [], SEO: [], AEO: [] };

  // overall counts (findings only)
  const blocking = findings.filter(f => f.status === 'fail').length;
  const warnings = findings.filter(f => f.status === 'warn').length;

  // per category
  const cats = ['UX', 'SEO', 'AEO'];
  const catData = {};
  for (const cat of cats) {
    const catFindings = findings.filter(f => f.cat === cat);
    const catModules = modules[cat] || [];
    const passCount = catModules.filter(m => (m.score || 0) >= 80).length;
    const failList = catFindings
      .map(f => ({ label: f.label, status: f.status, cat: f.cat }))
      .sort((a, b) => (a.status === 'fail' ? -1 : 1) - (b.status === 'fail' ? -1 : 1));
    catData[cat] = {
      modules: catModules,
      passCount,
      totalModules: catModules.length,
      issues: catFindings.length,
      failList
    };
  }

  function renderCard(cat) {
    if (!cat) {
      // overall card
      return `
        <div class="sum-card sum-overall" data-cat="overall">
          <div class="sum-head"><span class="sum-title">OVERALL</span></div>
          <div class="sum-counts">
            <span class="sum-count-fail">${blocking}</span> blocking ·
            <span class="sum-count-warn">${warnings}</span> warn
          </div>
          <div style="margin-top:auto;font-size:11px;color:var(--dim);letter-spacing:.04em">
            ${ctx.url ? ctx.url.replace('https://','').replace('http://','') : ''}
          </div>
        </div>`;
    }
    const d = catData[cat];
    const passRows = d.modules
      .slice()
      .sort((a, b) => (b.score || 0) - (a.score || 0))
      .map(m => {
        const passing = (m.score || 0) >= 80;
        return `<div class="sum-pass-row">
          <span class="name">${passing ? '✓' : '·'} ${escapeHtml(m.name)}</span>
          <span class="score">${Math.round(m.score || 0)}</span>
        </div>`;
      }).join('');

    const failRows = d.failList.length
      ? d.failList.slice(0, 6).map(f => {
          const cls = f.cat === 'AEO' ? 'aeo' : (f.status === 'fail' ? 'fail' : 'warn');
          const mark = f.status === 'fail' ? '✕' : '⚠';
          return `<div class="sum-finding ${cls}">${mark} ${escapeHtml(shorten(f.label, 42))}</div>`;
        }).join('')
      : '<div class="sum-no-fail">✓ no issues</div>';

    return `
      <div class="sum-card" data-cat="${cat}" data-expandable="1">
        <div class="sum-head">
          <span class="sum-title">${cat}</span>
          <span class="sum-toggle">▾</span>
        </div>
        <div class="sum-counts">
          <span class="sum-count-pass">${d.passCount}</span> pass ·
          <span class="sum-count-fail">${d.issues}</span> issue${d.issues===1?'':'s'}
        </div>
        <div class="sum-pass-list">${passRows || '<div class="sum-pass-row"><span class="name">—</span></div>'}</div>
        <div class="sum-fail-list">${failRows}</div>
      </div>`;
  }

  container.innerHTML = `<div class="sum-row">
    ${renderCard(null)}
    ${renderCard('UX')}
    ${renderCard('SEO')}
    ${renderCard('AEO')}
  </div>`;
  container.classList.remove('hidden');

  // wire expand toggles
  container.querySelectorAll('.sum-card[data-expandable="1"]').forEach(card => {
    card.addEventListener('click', e => {
      if (e.target.closest('.sum-finding')) return;
      card.classList.toggle('expanded');
    });
  });
}

function shorten(str, n) {
  str = String(str || '');
  return str.length > n ? str.slice(0, n - 1) + '…' : str;
}

// hook summary cards to audit settle
(function hookSummaryCards() {
  const statusEl = $('status');
  if (!statusEl) return;
  new MutationObserver(() => {
    if (statusEl.textContent === 'settled' && window._nusa) {
      buildSummaryCards(window._nusa);
      setProgress('settled', { busy: false });
    }
  }).observe(statusEl, { childList: true, characterData: true, subtree: true });
})();

// progress updates during the audit — run after the audit starts
(function hookProgress() {
  const statusEl = $('status');
  if (!statusEl) return;
  const narrationEl = $('narration');
  if (!narrationEl) return;
  new MutationObserver(muts => {
    for (const m of muts) {
      for (const node of m.addedNodes) {
        if (node.nodeType !== 1) continue;
        const t = node.textContent || '';
        if (/Opening .* via edge render/i.test(t))         setProgress('rendering…');
        else if (/Rendered .* chars/i.test(t))             setProgress('parsing DOM…');
        else if (/Running UX pass/i.test(t))               setProgress('running UX…');
        else if (/Running SEO pass/i.test(t))              setProgress('running SEO…');
        else if (/Running AEO pass/i.test(t))              setProgress('running AEO…');
        else if (/Audit settled/i.test(t))                 setProgress('settled', { busy: false });
      }
    }
  }).observe(narrationEl, { childList: true, subtree: false });
})();

