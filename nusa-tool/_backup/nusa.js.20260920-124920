// ── 1. Wrap twinAddNode so we count what actually renders ─────────
const _d2Add = twinAddNode;
twinAddNode = function (ev) {
  const before = TWIN.svg ? TWIN.svg.children.length : 0;
  const r = _d2Add.apply(this, arguments);
  const after = TWIN.svg ? TWIN.svg.children.length : 0;
  if (after > before) TWIN.drawn = (TWIN.drawn || 0) + 1;
  return r;
};

// ── 2. Full-width pin lines instead of coloured rects ─────────────
// A finding's tag tells us which twin node to anchor to. We draw a
// horizontal line at that node's y, spanning the full 390 width, with
// a small dot and the finding id at the left edge.

function twinPinLine(finding, ev) {
  if (!TWIN.svg || !ev || !ev.bbox) return null;
  const NS = 'http://www.w3.org/2000/svg';
  const y = ev.bbox.y + 2;
  const g = document.createElementNS(NS, 'g');
  g.setAttribute('class', 'pin-group');
  g.dataset.findingId = finding.id;

  const line = document.createElementNS(NS, 'line');
  line.setAttribute('x1', '0');
  line.setAttribute('x2', '390');
  line.setAttribute('y1', String(y));
  line.setAttribute('y2', String(y));
  const cls = finding.cat === 'AEO' ? 'pin-aeo' : (finding.status === 'fail' ? 'pin-fail' : 'pin-warn');
  line.setAttribute('class', 'pin ' + cls);
  g.appendChild(line);

  const dot = document.createElementNS(NS, 'circle');
  dot.setAttribute('cx', '3');
  dot.setAttribute('cy', String(y));
  dot.setAttribute('r', '3');
  dot.setAttribute('class', 'pin-dot ' + cls);
  g.appendChild(dot);

  TWIN.svg.appendChild(g);

  // pulse once on attach so the user sees it land
  line.classList.add('pulse');
  setTimeout(() => line.classList.remove('pulse'), 1500);

  // linkage: hover/click → narration
  g.style.cursor = 'pointer';
  g.addEventListener('mouseenter', () => {
    const p = narration.querySelector(`p.finding[data-finding-id="${finding.id}"]`);
    if (p) p.classList.add('pulse-text');
  });
  g.addEventListener('mouseleave', () => {
    const p = narration.querySelector(`p.finding[data-finding-id="${finding.id}"]`);
    if (p) p.classList.remove('pulse-text');
  });
  g.addEventListener('click', () => {
    const p = narration.querySelector(`p.finding[data-finding-id="${finding.id}"]`);
    if (p) {
      p.scrollIntoView({ behavior: 'smooth', block: 'center' });
      p.classList.add('pulse-text');
      setTimeout(() => p.classList.remove('pulse-text'), 1500);
    }
  });

  return g;
}

// ── 3. Replace pinFindingsToTwin with a per-tag matching pass ─────

// ═══════════════════════════════════════════════════════════════════
// pinFindingsToTwin — final, single definition
// ═══════════════════════════════════════════════════════════════════

function pinFindingsToTwin() {
  if (!TWIN.svg || !TWIN.events.length) return;
  const ctx = window._nusa;
  if (!ctx) return;

  const byTag = new Map();
  for (const ev of TWIN.events) {
    if (!ev.bbox || ev.bbox.w <= 0 || ev.bbox.h <= 0) continue;
    if (!byTag.has(ev.tag)) byTag.set(ev.tag, []);
    byTag.get(ev.tag).push(ev);
  }

  const DOM_RULES = [
    { re: /images? missing alt text/i,   tag: 'img' },
    { re: /^Missing page title$/i,       tag: 'title', fallback: 'head' },
    { re: /^Title is \d+ chars/i,        tag: 'title', fallback: 'head' },
    { re: /\d+ H1s on page/i,            tag: 'h1' },
    { re: /Readability weak/i,           tag: 'p' }
  ];

  const railFindings = [];
  const usedY = new Set();
  let railIndex = 0;
  const RAIL_START = 60;
  const RAIL_STEP = 80;

  for (const f of ctx.findings) {
    const rule = DOM_RULES.find(function (r) { return r.re.test(f.label); });

    if (rule) {
      let list = byTag.get(rule.tag) || [];
      if (!list.length && rule.fallback) list = byTag.get(rule.fallback) || [];
      if (list.length) {
        let placed = false;
        for (const cand of list) {
          const y = Math.round(cand.bbox.y);
          if (!usedY.has(y)) {
            usedY.add(y);
            f.twinId = cand.id;
            const g = twinPinLine(f, { bbox: { y: y }, id: cand.id });
            if (g) TWIN.findingPins.set(f.id, cand.id);
            placed = true;
            break;
          }
        }
        if (placed) continue;
      }
    }
    railFindings.push(f);
  }

  for (const f of railFindings) {
    const y = RAIL_START + railIndex * RAIL_STEP;
    railIndex++;
    const vb = (TWIN.svg.getAttribute('viewBox') || '0 0 390 844').split(' ');
    const docH = parseFloat(vb[3]) || 844;
    if (y + 40 > docH) {
      const newH = y + 80;
      TWIN.svg.setAttribute('viewBox', '0 0 390 ' + newH);
      TWIN.svg.style.aspectRatio = '390 / ' + newH;
    }
    const g = twinPinLine(f, { bbox: { y: y }, id: 'rail-' + f.id });
    if (g) {
      const line = g.querySelector('line');
      if (line) line.setAttribute('x2', '48');
      TWIN.findingPins.set(f.id, 'rail-' + f.id);
    }
  }

  twinSetMeta();

  narration.querySelectorAll('p.finding').forEach(function (p) {
    if (p.dataset.pinWired === '1') return;
    p.dataset.pinWired = '1';
    const fid = p.dataset.findingId;
    if (!fid) return;
    const g = TWIN.svg.querySelector('.pin-group[data-finding-id="' + fid + '"]');
    if (!g) return;
    const line = g.querySelector('line');

    p.addEventListener('mouseenter', function () {
      line.classList.add('pulse');
      setTimeout(function () { line.classList.remove('pulse'); }, 1400);
    });

    p.style.cursor = 'pointer';
    p.addEventListener('click', function (e) {
      if (e.target.closest('.bolt')) return;
      const y = parseFloat(line.getAttribute('y1'));
      const twinCol = $('twin-col');
      if (twinCol && TWIN.svg) {
        const colRect = twinCol.getBoundingClientRect();
        const svgRect = TWIN.svg.getBoundingClientRect();
        const vbH = TWIN.svg.viewBox.baseVal.height || 1;
        const scale = svgRect.height / vbH;
        const targetY = svgRect.top + (y * scale) - colRect.height * 0.4;
        twinCol.scrollTo({ top: twinCol.scrollTop + (targetY - colRect.top), behavior: 'smooth' });
      }
      line.classList.add('pulse');
      setTimeout(function () { line.classList.remove('pulse'); }, 1400);
    });
  });
}

