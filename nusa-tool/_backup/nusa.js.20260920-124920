// ─── 1. Scrub-to-rewind ───────────────────────────────────────────
// Snapshots the twin to a target ms by hiding rects whose event.ms > target.
// No server round-trip — we replay from the buffered TWIN.events.

function twinScrubTo(targetMs) {
  if (!TWIN.svg) return;
  const rects = TWIN.svg.querySelectorAll('rect.node');
  let shown = 0;
  rects.forEach(r => {
    const ev = TWIN.byId.get(r.dataset.id);
    if (!ev) return;
    if (ev.ms <= targetMs) {
      r.style.display = '';
      r.classList.add('in');
      shown++;
    } else {
      r.style.display = 'none';
    }
  });
  const t = $('twin-time');
  if (t) t.textContent = Math.round(targetMs) + 'ms';
  return shown;
}

// Attach scrub affordance to the ruler — drag the playhead anywhere.
function twinAttachScrub() {
  const ruler = $('ruler');
  const ph = $('playhead');
  if (!ruler || !ph || ruler.dataset.scrubReady === '1') return;
  ruler.dataset.scrubReady = '1';
  ruler.style.cursor = 'ew-resize';
  ruler.style.position = 'relative';

  let dragging = false;

  function fromX(clientX) {
    const rect = ruler.getBoundingClientRect();
    const pct = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
    return { pct, ms: Math.round(pct * maxEventMs()) };
  }
  function maxEventMs() {
    return TWIN.events.length ? TWIN.events[TWIN.events.length - 1].ms : 1;
  }

  function onMove(clientX) {
    const { pct, ms } = fromX(clientX);
    ph.style.transform = `translateX(${pct * 100}%)`;
    twinScrubTo(ms);
  }

  ruler.addEventListener('mousedown', e => {
    if (!TWIN.svg) return;
    dragging = true;
    ph.style.transition = 'none';
    onMove(e.clientX);
    e.preventDefault();
  });
  window.addEventListener('mousemove', e => {
    if (!dragging) return;
    onMove(e.clientX);
  });
  window.addEventListener('mouseup', () => {
    if (!dragging) return;
    dragging = false;
    ph.style.transition = '';
  });

  // touch support
  ruler.addEventListener('touchstart', e => {
    if (!TWIN.svg) return;
    dragging = true;
    ph.style.transition = 'none';
    onMove(e.touches[0].clientX);
    e.preventDefault();
  }, { passive: false });
  window.addEventListener('touchmove', e => {
    if (!dragging) return;
    onMove(e.touches[0].clientX);
  }, { passive: false });
  window.addEventListener('touchend', () => {
    if (!dragging) return;
    dragging = false;
    ph.style.transition = '';
  });
}

// ─── 2. Bidirectional hover linkage ───────────────────────────────
// Hover a pin → narration scrolls to its finding sentence
// Hover a finding sentence → its pin pulses

function twinWireHover() {
  if (!TWIN.svg) return;
  // pins -> narration
  TWIN.svg.querySelectorAll('rect.node').forEach(r => {
    const id = r.dataset.id;
    const finding = (window._nusa?.findings || []).find(f => f.twinId === id);
    if (!finding) return;

    r.addEventListener('mouseenter', () => {
      r.classList.add('hit');
      const p = narration.querySelector(`p.finding[data-finding-id="${finding.id}"]`);
      if (p && !p.dataset.scrolled) {
        p.dataset.scrolled = '1';
        p.scrollIntoView({ behavior: 'smooth', block: 'center' });
        p.style.transition = 'color .3s';
        const orig = p.style.color;
        p.style.color = 'var(--violet)';
        setTimeout(() => { p.style.color = orig; }, 900);
      }
    });
    r.addEventListener('mouseleave', () => {
      r.classList.remove('hit');
    });
  });

  // narration -> pins
  narration.querySelectorAll('p.finding').forEach(p => {
    if (p.dataset.hoverWired === '1') return;
    p.dataset.hoverWired = '1';
    const fid = p.dataset.findingId;
    if (!fid) return;
    const finding = (window._nusa?.findings || []).find(f => f.id === fid);
    if (!finding || !finding.twinId) return;
    const rect = TWIN.svg.querySelector(`rect[data-id="${finding.twinId}"]`);
    if (!rect) return;

    p.addEventListener('mouseenter', () => {
      rect.classList.add('hit');
      rect.classList.add('pulse');
      setTimeout(() => rect.classList.remove('pulse'), 1200);
    });
    p.addEventListener('mouseleave', () => {
      rect.classList.remove('hit');
    });
  });
}

// ─── 3. Click a pin → jump to its finding ─────────────────────────
function twinWireClick() {
  if (!TWIN.svg) return;
  TWIN.svg.querySelectorAll('rect.node').forEach(r => {
    const id = r.dataset.id;
    const finding = (window._nusa?.findings || []).find(f => f.twinId === id);
    if (!finding) return;
    r.style.cursor = 'pointer';
    r.addEventListener('click', () => {
      const p = narration.querySelector(`p.finding[data-finding-id="${finding.id}"]`);
      if (p) {
        p.scrollIntoView({ behavior: 'smooth', block: 'center' });
        // flash the sentence
        p.style.transition = 'background .3s';
        const prev = p.style.background;
        p.style.background = 'rgba(167,139,250,.14)';
        setTimeout(() => { p.style.background = prev; }, 1200);
      }
    });
  });
}

