      <!-- Main Content -->
      <main class="py-16 bg-gray-50/80 dark:bg-gray-950/80 backdrop-blur-sm">
        <article class="max-w-7xl mx-auto px-2">
          <div class="bg-white/10 dark:bg-black/40 backdrop-blur-xl rounded-3xl shadow-2xl p-2 md:p-4 prose prose-lg dark:prose-invert max-w-none border border-white/10 dark:border-white/5">

            <!-- Featured Image -->
            <picture class="mb-12 block">
              <source media="(max-width: 640px)" srcset="/blog/images/social/social-help-guide-640w.webp">
              <source media="(min-width: 641px)" srcset="/blog/images/social/social-help-guide-1200w.webp">
              <img
                src="/blog/images/social/social-help-guide-1200w.webp"
                alt="Traffic Torch community help guide – torches, profiles, leaderboard and network"
                class="w-full rounded-2xl shadow-xl object-cover aspect-[1200/630] md:aspect-[4/3] lg:aspect-[16/9] max-h-[60vh] mx-auto"
                loading="eager"
                decoding="async"
                fetchpriority="high"
                width="1200"
                height="630">
            </picture>

            <!-- Title -->
            <h1 class="text-3xl text-center md:text-4xl lg:text-5xl font-black mb-5 bg-gradient-to-r from-orange-400 via-pink-500 to-purple-600 bg-clip-text text-transparent leading-tight">
              Traffic Torch Community Help Guide – Torches, Profiles, Leaderboard &amp; Network
            </h1>

            <!-- Subtitle -->
            <p class="text-xl md:text-2xl text-center font-medium text-gray-700 dark:text-gray-300 mb-10 leading-relaxed max-w-4xl">
              How to share audit results, build a public profile, earn points, connect with other SEOs, and get your site noticed.
            </p>

            <!-- Introduction -->
            <div class="prose prose-lg prose-orange dark:prose-invert max-w-none mb-12">
              <p class="text-gray-800 dark:text-gray-200 leading-relaxed text-lg">
                Traffic Torch isn't just a suite of audit tools – it's a <strong>community of SEOs, designers, and site owners</strong> who share what they find. Every time you run an audit, you can post it as a <strong>torch</strong>: a public result with its own page, share image, and permanent link.
              </p>
              <p class="text-gray-800 dark:text-gray-200 leading-relaxed text-lg mt-6">
                This guide walks through the whole social layer: how torches work, what your profile page shows, how the leaderboard ranks you, how to build a network, and how points are earned. If you're here to use the tools, start with the tool help guides instead. If you're here to be part of the community, keep reading.
              </p>
            </div>

            <!-- Table of Contents -->
            <nav id="table-of-contents" class="bg-white dark:bg-gray-900 p-4 md:p-6 mt-10 rounded-2xl shadow-lg mb-12 border border-gray-200 dark:border-gray-700 sticky top-4 z-10">
