                   class="inline-block px-10 py-6 bg-gradient-to-r from-orange-500 via-pink-600 to-purple-600 text-white font-bold text-2xl rounded-2xl hover:brightness-110 hover:scale-[1.05] transition-all duration-300 shadow-2xl shadow-orange-500/50">
