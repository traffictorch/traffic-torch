          { "@type": "Question", "name": "What is the Round Table?", "acceptedAnswer": { "@type": "Answer", "text": "The Round Table is Traffic Torch's community governance system. Every eligible user has equal voting authority, there are no administrators inside the system, and every decision is recorded on a tamper-evident audit chain. Proposals move through four phases — Propose, Discuss, Vote, Execute — with fixed rules that can only be changed by another vote." } },
          { "@type": "Question", "name": "Do I need an account to view the Round Table?", "acceptedAnswer": { "@type": "Answer", "text": "No. All proposals, votes, comments, bench activity, and the audit chain are publicly readable. You only need an account to submit a proposal, cast a vote, or leave a comment." } },
          { "@type": "Question", "name": "How is eligibility determined?", "acceptedAnswer": { "@type": "Answer", "text": "An account must be at least 7 days old AND have either a verified profile (email verification or higher) OR a public profile. This is the exact rule the server enforces. It prevents brand-new accounts from voting while remaining open to anyone who has actually participated." } },
