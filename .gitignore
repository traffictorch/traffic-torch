# ─── Cloudflare / Wrangler / DevContainer caches ──────
# These were the cause of the Pages 25 MiB per-file build failure.
# Never ship them. Never commit them.
.wrangler/
.cache/
.config/
.npm-cache/
.devcontainer/

# Only ignore cache folders inside workers/, keep worker source tracked
workers/.cache/
workers/.config/
workers/.wrangler/
workers/*/node_modules/
workers/*/.wrangler/
workers/*/.cache/

# ─── Cloudflare Pages Functions build artifacts ───────
functions/**/node_modules/
functions/**/.wrangler/

# ─── Framework cache artifacts (accidental 64-char hash files) ───
